#!/usr/bin/env bash
set -euo pipefail

WORKSPACE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG_DIR="$WORKSPACE_ROOT/config"
REGISTRY_FILE="$CONFIG_DIR/projects.tsv"
TRACKER_FILE="$CONFIG_DIR/bounties.tsv"
PROJECTS_DIR="$WORKSPACE_ROOT/projects"

ensure_layout() {
  mkdir -p "$CONFIG_DIR" "$PROJECTS_DIR"
  touch "$REGISTRY_FILE"
  touch "$TRACKER_FILE"
}

usage() {
  cat <<'USAGE'
AU workspace CLI (multi-project)

Usage:
  au list
  au add <name> <path>
  au remove <name>
  au new <name>
  au run <command...>
  au exec <name> <command...>
  au status
  au paths
  au bounty list
  au bounty add <id> <project> <issue_url> --title "<title>" [--priority <level>] [--owner <owner>] [--status <status>] [--progress <0-100>] [--next "<text>"] [--blocker "<text>"]
  au bounty show <id>
  au bounty move <id> <status>
  au bounty progress <id> <0-100>
  au bounty next <id> <text...>
  au bounty block <id> <text...>
  au bounty owner <id> <owner>
  au bounty priority <id> <level>
  au bounty note <id> <text...>
  au bounty board

Examples:
  au add bountyos ..
  au new sidecar-service
  au run git status -sb
  au exec web-app npm run build
  au bounty board
USAGE
}

require_args() {
  local need="$1"
  local got="$2"
  if (( got < need )); then
    usage
    exit 1
  fi
}

validate_name() {
  local name="$1"
  if [[ ! "$name" =~ ^[a-z0-9][a-z0-9._-]*$ ]]; then
    echo "error: invalid project name '$name'" >&2
    echo "allowed: lowercase letters, numbers, dot, underscore, dash" >&2
    exit 1
  fi
}

resolve_path() {
  local p="$1"
  if [[ ! -d "$p" ]]; then
    echo "error: directory does not exist: $p" >&2
    exit 1
  fi
  (
    cd "$p"
    pwd
  )
}

sanitize_field() {
  local raw="$1"
  raw="${raw//$'\t'/ }"
  raw="${raw//$'\n'/ }"
  raw="${raw//$'\r'/ }"
  # shellcheck disable=SC2001
  echo "$(echo "$raw" | sed 's/[[:space:]]\+/ /g' | sed 's/^ //; s/ $//')"
}

utc_now() {
  date -u +"%Y-%m-%dT%H:%M:%SZ"
}

project_exists() {
  local target="$1"
  awk -F '\t' -v n="$target" '$1 == n { found=1 } END { exit found ? 0 : 1 }' "$REGISTRY_FILE"
}

project_path() {
  local project_name="$1"
  awk -F '\t' -v n="$project_name" '$1 == n { print $2; found=1 } END { if (!found) exit 1 }' "$REGISTRY_FILE"
}

list_projects() {
  local count=0
  printf '%-22s %-8s %s\n' "NAME" "STATE" "PATH"
  printf '%-22s %-8s %s\n' "----------------------" "--------" "----"
  while IFS=$'\t' read -r name path; do
    [[ -z "${name:-}" ]] && continue
    local state="ok"
    if [[ ! -d "$path" ]]; then
      state="missing"
    fi
    printf '%-22s %-8s %s\n' "$name" "$state" "$path"
    count=$((count + 1))
  done < "$REGISTRY_FILE"

  if (( count == 0 )); then
    echo "(no projects registered)"
  fi
}

add_project() {
  require_args 2 "$#"
  local name="$1"
  local path="$2"
  validate_name "$name"
  local abs
  abs="$(resolve_path "$path")"

  if project_exists "$name"; then
    echo "error: project already exists: $name" >&2
    exit 1
  fi

  printf '%s\t%s\n' "$name" "$abs" >> "$REGISTRY_FILE"
  echo "added: $name -> $abs"
}

remove_project() {
  require_args 1 "$#"
  local name="$1"

  if ! project_exists "$name"; then
    echo "error: unknown project: $name" >&2
    exit 1
  fi

  local tmp
  tmp="$(mktemp)"
  awk -F '\t' -v n="$name" '$1 != n { print }' "$REGISTRY_FILE" > "$tmp"
  mv "$tmp" "$REGISTRY_FILE"
  echo "removed: $name"
}

new_project() {
  require_args 1 "$#"
  local name="$1"
  validate_name "$name"
  local target="$PROJECTS_DIR/$name"

  if project_exists "$name"; then
    echo "error: project already exists in registry: $name" >&2
    exit 1
  fi
  if [[ -e "$target" ]]; then
    echo "error: path already exists: $target" >&2
    exit 1
  fi

  mkdir -p "$target/docs" "$target/scripts" "$target/resources/raw" "$target/output"
  cat > "$target/README.md" <<TPL
# $name

Project scaffold created by AU workspace.

## Structure

- \`docs/\` - project notes and plan
- \`scripts/\` - repeatable commands
- \`resources/raw/\` - pulled external/local references
- \`output/\` - generated artifacts (claims, reports)
TPL

  : > "$target/output/.gitkeep"
  printf '%s\t%s\n' "$name" "$target" >> "$REGISTRY_FILE"
  echo "created: $target"
  echo "registered: $name"
}

run_all() {
  require_args 1 "$#"
  local cmd="$*"
  local failures=0
  local count=0

  while IFS=$'\t' read -r name path; do
    [[ -z "${name:-}" ]] && continue
    count=$((count + 1))
    echo
    echo "==> [$name] $path"
    if [[ ! -d "$path" ]]; then
      echo "missing path: $path"
      failures=$((failures + 1))
      continue
    fi
    if ! (cd "$path" && bash -lc "$cmd"); then
      failures=$((failures + 1))
    fi
  done < "$REGISTRY_FILE"

  if (( count == 0 )); then
    echo "no projects to run"
    exit 1
  fi
  if (( failures > 0 )); then
    echo
    echo "completed with failures: $failures"
    exit 2
  fi

  echo
  echo "completed successfully across $count project(s)"
}

exec_one() {
  require_args 2 "$#"
  local name="$1"
  shift
  local cmd="$*"
  local path
  path="$(awk -F '\t' -v n="$name" '$1 == n { print $2 }' "$REGISTRY_FILE")"

  if [[ -z "$path" ]]; then
    echo "error: unknown project: $name" >&2
    exit 1
  fi
  if [[ ! -d "$path" ]]; then
    echo "error: project path missing: $path" >&2
    exit 1
  fi

  echo "==> [$name] $path"
  (cd "$path" && bash -lc "$cmd")
}

status_all() {
  run_all git status -sb
}

valid_status() {
  case "$1" in
    backlog|ready|in_progress|blocked|review|submitted|paid|done|dropped) return 0 ;;
    *) return 1 ;;
  esac
}

valid_priority() {
  case "$1" in
    low|medium|high|critical) return 0 ;;
    *) return 1 ;;
  esac
}

validate_progress() {
  local p="$1"
  if [[ ! "$p" =~ ^[0-9]+$ ]]; then
    return 1
  fi
  if (( p < 0 || p > 100 )); then
    return 1
  fi
  return 0
}

bounty_exists() {
  local id="$1"
  awk -F '\t' -v id="$id" '$1 == id { found=1 } END { exit found ? 0 : 1 }' "$TRACKER_FILE"
}

bounty_get_field() {
  local id="$1"
  local idx="$2"
  awk -F '\t' -v id="$id" -v idx="$idx" '$1 == id { print $idx; found=1 } END { if (!found) exit 1 }' "$TRACKER_FILE"
}

update_bounty_field() {
  local id="$1"
  local idx="$2"
  local value="$3"
  local now
  now="$(utc_now)"
  local tmp
  tmp="$(mktemp)"
  awk -F '\t' -v OFS='\t' -v id="$id" -v idx="$idx" -v value="$value" -v now="$now" '
    $1 == id { $idx = value; $12 = now; found=1 }
    { print }
    END { if (!found) exit 1 }
  ' "$TRACKER_FILE" > "$tmp" || {
    rm -f "$tmp"
    echo "error: unknown bounty id: $id" >&2
    exit 1
  }
  mv "$tmp" "$TRACKER_FILE"
}

list_bounties() {
  local count=0
  printf '%-22s %-12s %-6s %-8s %-14s %-20s %s\n' "ID" "STATUS" "PROG%" "PRIORITY" "OWNER" "PROJECT" "NEXT ACTION"
  printf '%-22s %-12s %-6s %-8s %-14s %-20s %s\n' "----------------------" "------------" "------" "--------" "--------------" "--------------------" "-----------"

  while IFS=$'\t' read -r id issue_url title project status priority owner progress next_action blocker created_at updated_at; do
    [[ -z "${id:-}" ]] && continue
    local preview="$next_action"
    if (( ${#preview} > 48 )); then
      preview="${preview:0:45}..."
    fi
    printf '%-22s %-12s %-6s %-8s %-14s %-20s %s\n' "$id" "$status" "$progress" "$priority" "$owner" "$project" "$preview"
    count=$((count + 1))
  done < "$TRACKER_FILE"

  if (( count == 0 )); then
    echo "(no bounties tracked)"
  fi
}

bounty_add() {
  require_args 3 "$#"
  local id="$1"
  local project="$2"
  local issue_url="$3"
  shift 3

  validate_name "$id"
  if ! project_exists "$project"; then
    echo "error: unknown project: $project" >&2
    exit 1
  fi
  if bounty_exists "$id"; then
    echo "error: bounty already exists: $id" >&2
    exit 1
  fi

  local title=""
  local status="backlog"
  local priority="medium"
  local owner="unassigned"
  local progress="0"
  local next_action="-"
  local blocker="-"

  while (( $# > 0 )); do
    case "$1" in
      --title)
        title="${2:-}"
        shift 2
        ;;
      --status)
        status="${2:-}"
        shift 2
        ;;
      --priority)
        priority="${2:-}"
        shift 2
        ;;
      --owner)
        owner="${2:-}"
        shift 2
        ;;
      --progress)
        progress="${2:-}"
        shift 2
        ;;
      --next)
        next_action="${2:-}"
        shift 2
        ;;
      --blocker)
        blocker="${2:-}"
        shift 2
        ;;
      *)
        echo "error: unknown option for bounty add: $1" >&2
        exit 1
        ;;
    esac
  done

  if [[ -z "$title" ]]; then
    echo "error: --title is required" >&2
    exit 1
  fi
  if ! valid_status "$status"; then
    echo "error: invalid status '$status'" >&2
    exit 1
  fi
  if ! valid_priority "$priority"; then
    echo "error: invalid priority '$priority'" >&2
    exit 1
  fi
  if ! validate_progress "$progress"; then
    echo "error: invalid progress '$progress' (expected 0-100)" >&2
    exit 1
  fi

  title="$(sanitize_field "$title")"
  owner="$(sanitize_field "$owner")"
  next_action="$(sanitize_field "$next_action")"
  blocker="$(sanitize_field "$blocker")"
  issue_url="$(sanitize_field "$issue_url")"

  local now
  now="$(utc_now)"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$id" "$issue_url" "$title" "$project" "$status" "$priority" "$owner" "$progress" "$next_action" "$blocker" "$now" "$now" >> "$TRACKER_FILE"
  echo "added bounty: $id"
}

bounty_show() {
  require_args 1 "$#"
  local id="$1"
  if ! bounty_exists "$id"; then
    echo "error: unknown bounty id: $id" >&2
    exit 1
  fi

  local issue_url title project status priority owner progress next_action blocker created_at updated_at
  issue_url="$(bounty_get_field "$id" 2)"
  title="$(bounty_get_field "$id" 3)"
  project="$(bounty_get_field "$id" 4)"
  status="$(bounty_get_field "$id" 5)"
  priority="$(bounty_get_field "$id" 6)"
  owner="$(bounty_get_field "$id" 7)"
  progress="$(bounty_get_field "$id" 8)"
  next_action="$(bounty_get_field "$id" 9)"
  blocker="$(bounty_get_field "$id" 10)"
  created_at="$(bounty_get_field "$id" 11)"
  updated_at="$(bounty_get_field "$id" 12)"

  local path=""
  if path="$(project_path "$project" 2>/dev/null)"; then
    :
  else
    path="(missing project path)"
  fi

  cat <<EOF2
id:          $id
title:       $title
issue_url:   $issue_url
project:     $project
project_path:$path
status:      $status
priority:    $priority
owner:       $owner
progress:    $progress
next_action: $next_action
blocker:     $blocker
created_at:  $created_at
updated_at:  $updated_at
EOF2
}

bounty_move() {
  require_args 2 "$#"
  local id="$1"
  local status="$2"
  if ! valid_status "$status"; then
    echo "error: invalid status '$status'" >&2
    exit 1
  fi
  update_bounty_field "$id" 5 "$status"
  echo "updated $id status -> $status"
}

bounty_progress() {
  require_args 2 "$#"
  local id="$1"
  local progress="$2"
  if ! validate_progress "$progress"; then
    echo "error: invalid progress '$progress' (expected 0-100)" >&2
    exit 1
  fi
  update_bounty_field "$id" 8 "$progress"
  echo "updated $id progress -> $progress"
}

bounty_next() {
  require_args 2 "$#"
  local id="$1"
  shift
  local text
  text="$(sanitize_field "$*")"
  [[ -z "$text" ]] && text="-"
  update_bounty_field "$id" 9 "$text"
  echo "updated $id next_action"
}

bounty_block() {
  require_args 2 "$#"
  local id="$1"
  shift
  local text
  text="$(sanitize_field "$*")"
  [[ -z "$text" ]] && text="-"
  update_bounty_field "$id" 10 "$text"
  echo "updated $id blocker"
}

bounty_owner() {
  require_args 2 "$#"
  local id="$1"
  shift
  local owner
  owner="$(sanitize_field "$*")"
  if [[ -z "$owner" ]]; then
    echo "error: owner cannot be empty" >&2
    exit 1
  fi
  update_bounty_field "$id" 7 "$owner"
  echo "updated $id owner -> $owner"
}

bounty_priority() {
  require_args 2 "$#"
  local id="$1"
  local level="$2"
  if ! valid_priority "$level"; then
    echo "error: invalid priority '$level'" >&2
    exit 1
  fi
  update_bounty_field "$id" 6 "$level"
  echo "updated $id priority -> $level"
}

bounty_note() {
  require_args 2 "$#"
  local id="$1"
  shift
  local note
  note="$(sanitize_field "$*")"
  if [[ -z "$note" ]]; then
    echo "error: note cannot be empty" >&2
    exit 1
  fi
  if ! bounty_exists "$id"; then
    echo "error: unknown bounty id: $id" >&2
    exit 1
  fi

  local project
  project="$(bounty_get_field "$id" 4)"
  local project_dir
  if ! project_dir="$(project_path "$project" 2>/dev/null)"; then
    echo "error: project not found for bounty: $project" >&2
    exit 1
  fi

  local note_file="$project_dir/output/progress_notes.md"
  mkdir -p "$(dirname "$note_file")"
  printf -- '- %s %s\n' "$(utc_now)" "$note" >> "$note_file"
  echo "appended note: $note_file"
}

bounty_board() {
  local statuses=("backlog" "ready" "in_progress" "blocked" "review" "submitted" "paid" "done" "dropped")
  local st
  local total=0

  for st in "${statuses[@]}"; do
    local count
    count="$(awk -F '\t' -v st="$st" '$5 == st { c++ } END { print c+0 }' "$TRACKER_FILE")"
    if (( count == 0 )); then
      continue
    fi
    total=$((total + count))
    echo
    echo "[$st] ($count)"
    awk -F '\t' -v st="$st" '
      $5 == st {
        title = $3
        if (length(title) > 70) {
          title = substr(title, 1, 67) "..."
        }
        printf("  - %s (%s%%, %s, owner=%s) %s\n", $1, $8, $6, $7, title)
      }
    ' "$TRACKER_FILE"
  done

  if (( total == 0 )); then
    echo "(no bounties tracked)"
  fi
}

bounty_dispatch() {
  if (( $# == 0 )); then
    echo "error: missing bounty subcommand" >&2
    usage
    exit 1
  fi

  local sub="$1"
  shift || true
  case "$sub" in
    list) list_bounties ;;
    add) bounty_add "$@" ;;
    show) bounty_show "$@" ;;
    move) bounty_move "$@" ;;
    progress) bounty_progress "$@" ;;
    next) bounty_next "$@" ;;
    block) bounty_block "$@" ;;
    owner) bounty_owner "$@" ;;
    priority) bounty_priority "$@" ;;
    note) bounty_note "$@" ;;
    board) bounty_board ;;
    *)
      echo "error: unknown bounty subcommand: $sub" >&2
      usage
      exit 1
      ;;
  esac
}

show_paths() {
  cat <<EOF2
workspace_root: $WORKSPACE_ROOT
config_dir:     $CONFIG_DIR
registry_file:  $REGISTRY_FILE
tracker_file:   $TRACKER_FILE
projects_dir:   $PROJECTS_DIR
EOF2
}

main() {
  ensure_layout

  if (( $# == 0 )); then
    usage
    exit 1
  fi

  local sub="$1"
  shift || true

  case "$sub" in
    list) list_projects ;;
    add) add_project "$@" ;;
    remove) remove_project "$@" ;;
    new) new_project "$@" ;;
    run) run_all "$@" ;;
    exec) exec_one "$@" ;;
    status) status_all ;;
    paths) show_paths ;;
    bounty) bounty_dispatch "$@" ;;
    -h|--help|help) usage ;;
    *)
      echo "error: unknown command: $sub" >&2
      usage
      exit 1
      ;;
  esac
}

main "$@"
